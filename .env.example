NODE_ENV=development
HOST=0.0.0.0
PORT=10000
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4892

# Generate a long random secret for sessions; required for production sign-in.
SESSION_SECRET=
KASHNODE_ADMIN_EMAIL=admin@example.com
KASHNODE_ADMIN_PASSWORD_HASH=
KASHNODE_ADMIN_NAME=Workspace Admin

# Device posts use Authorization: Bearer <token>. Use at least 32 random bytes.
KASHNODE_DEVICE_TOKEN=
KASHNODE_DEVICE_ID=
SIM_DATA_QUOTA_MB=10240

# PostgreSQL connection string. Keep credentials out of source control.
DATABASE_URL=
SUPABASE_URL=https://your-project-ref.supabase.co

# Signup OTP email delivery uses the Resend HTTP API (not SMTP/Nodemailer).
# Create a Resend API key with Sending access and scope it to your verified domain.
RESEND_API_KEY=
# The sender must use a domain you own and have verified in Resend DNS.
# Do NOT use gmail.com, yahoo.com, outlook.com, or another public mailbox domain.
AUTH_EMAIL_FROM=KashNode <no-reply@your-verified-domain.com>
# Unique random secret of at least 32 bytes; never commit the real value.
AUTH_OTP_SECRET=

# Google Identity Services Web OAuth client ID (backend verifies the ID token).
GOOGLE_CLIENT_ID=
# Frontend Google sign-in: the SAME Google web OAuth client id, exposed to Vite.
# Without this, the /login "Continue with Google" button shows a configuration
# message instead of starting Google sign-in.
VITE_GOOGLE_CLIENT_ID=


# Live voice runtime (Android KashNode Box).
# Deepgram Nova-3 receives mono PCM16 little-endian at 16 kHz.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=bn
VOICE_WS_PATH=/ws/voice
VOICE_LLM_PROVIDER=openai
VOICE_LANGUAGE=bn-BD
VOICE_SAMPLE_RATE=16000
# Bengali TTS currently uses Google Cloud Text-to-Speech (bn-IN voice).
GOOGLE_TTS_SERVICE_ACCOUNT_JSON=
# Alternative: provide a short-lived OAuth token from your secret manager.
GOOGLE_TTS_ACCESS_TOKEN=
GOOGLE_TTS_LANGUAGE=bn-IN
GOOGLE_TTS_VOICE=bn-IN-Wavenet-A
VOICE_TTS_SAMPLE_RATE=24000
VOICE_MAX_SESSIONS_PER_MERCHANT=2
VOICE_MAX_AUDIO_FRAME_BYTES=65536
VOICE_MAX_BUFFERED_BYTES=524288
VOICE_MAX_TURNS=30
VOICE_MAX_SESSION_MS=600000
VOICE_UPSTREAM_TIMEOUT_MS=12000
VOICE_LLM_TIMEOUT_MS=18000
VOICE_TTS_TIMEOUT_MS=25000
VOICE_HEARTBEAT_MS=30000
